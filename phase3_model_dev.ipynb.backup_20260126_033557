    "# Build TCN model - relaxed regularization (resuscitated)\n",
    "def build_tcn_model(sequence_length, n_features, learning_rate=0.0001):\n",
    "    inputs = tf.keras.layers.Input(shape=(sequence_length, n_features))\n",
    "\n",
    "    # Block 1\n",
    "    x = tf.keras.layers.Conv1D(32, 3, padding='same', activation='relu')(inputs)\n",
    "    x = tf.keras.layers.BatchNormalization()(x)\n",
    "    x = tf.keras.layers.SpatialDropout1D(0.3)(x)  # relaxed from 0.65\n",
    "\n",
    "    # Block 2 with dilation\n",
    "    x = tf.keras.layers.Conv1D(32, 3, padding='same', activation='relu', dilation_rate=2)(x)\n",
    "    x = tf.keras.layers.BatchNormalization()(x)\n",
    "    x = tf.keras.layers.SpatialDropout1D(0.3)(x)\n",
    "\n",
    "    x = tf.keras.layers.GlobalAveragePooling1D()(x)\n",
    "\n",
    "    # Simpler dense head\n",
    "    x = tf.keras.layers.Dense(16, activation='relu', kernel_regularizer=tf.keras.regularizers.l2(0.01))(x)\n",
    "    x = tf.keras.layers.Dropout(0.4)(x)\n",
    "\n",
    "    outputs = tf.keras.layers.Dense(3, activation='softmax')(x)\n",
    "\n",
    "    model = tf.keras.Model(inputs, outputs)\n",
    "    model.compile(optimizer=Adam(learning_rate=learning_rate), \n",
    "                  loss='categorical_crossentropy', metrics=['accuracy'])\n",
    "    return model\n",
    "\n",
    "# Build TCN\n",
    "tcn_model = build_tcn_model(\n",
    "    sequence_length=sequence_length,\n",
    "    n_features=X_tcn_train_aug.shape[2],\n",
    "    learning_rate=0.0001\n",
    ")\n",
