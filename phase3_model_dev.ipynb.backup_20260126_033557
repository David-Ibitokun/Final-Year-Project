    "        logs['val_recall_high'] = recall_high\n",
    "        \n",
    "        # Early stopping on macro F1\n",
    "        if macro_f1 > (self.best_macro_f1 + self.min_delta):\n",
    "            self.best_macro_f1 = macro_f1\n",
    "            self.wait = 0\n",
