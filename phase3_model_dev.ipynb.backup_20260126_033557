    "# Build Hybrid (TCN+GRU) model with noise injection\n",
    "def build_hybrid_tcn_gru_model(sequence_length, n_features, learning_rate=0.0001):\n",
    "    inputs = tf.keras.layers.Input(shape=(sequence_length, n_features))\n",
    "\n",
    "    # Noise injection to prevent memorization\n",
    "    x_noisy = tf.keras.layers.GaussianNoise(0.1)(inputs)\n",
    "\n",
    "    # Branch 1: Simple TCN\n",
    "    tcn = tf.keras.layers.Conv1D(16, 3, padding='same', activation='relu')(x_noisy)\n",
    "    tcn = tf.keras.layers.GlobalAveragePooling1D()(tcn)\n",
    "    \n",
    "    # Branch 2: Simple GRU\n",
    "    gru = tf.keras.layers.Bidirectional(tf.keras.layers.GRU(16, return_sequences=False))(x_noisy)\n",
    "    \n",
    "    # Concatenate\n",
    "    x = tf.keras.layers.concatenate([tcn, gru])\n",
    "\n",
    "    # Strong regularization at fusion\n",
    "    x = tf.keras.layers.BatchNormalization()(x)\n",
    "    x = tf.keras.layers.Dropout(0.6)(x)\n",
    "    \n",
    "    x = tf.keras.layers.Dense(16, activation='relu', kernel_regularizer=tf.keras.regularizers.l2(0.05))(x)\n",
    "    outputs = tf.keras.layers.Dense(3, activation='softmax')(x)\n",
    "    \n",
    "    model = tf.keras.Model(inputs, outputs)\n",
    "    model.compile(optimizer=Adam(learning_rate=learning_rate), \n",
    "                  loss='categorical_crossentropy', metrics=['accuracy'])\n",
    "    return model\n",
    "\n",
    "# Build improved TCN+GRU model\n",
    "sequence_length = X_hybrid_temp_aug.shape[1]\n",
    "n_features = X_hybrid_temp_aug.shape[2]  # Use temporal features only\n",
    "\n",
    "hybrid_model = build_hybrid_tcn_gru_model(\n",
    "    sequence_length=sequence_length,\n",
    "    n_features=n_features,\n",
    "    learning_rate=0.0001\n",
    ")\n",
    "\n",
    "hybrid_model.summary()"
