    "class MetricsCallback(tf.keras.callbacks.Callback):\n",
    "    \"\"\"Track macro-F1 and High class recall for imbalanced evaluation.\"\"\"\n",
    "    def __init__(self, val_data, val_labels, patience=5, min_delta=0.001):\n",
    "        super().__init__()\n",
    "        self.val_data = val_data\n",
    "        self.val_labels = val_labels\n",
    "        self.patience = patience\n",
    "        self.min_delta = min_delta\n",
    "        self.best_macro_f1 = -float('inf')\n",
    "        self.wait = 0\n",
    "        \n",
    "    def on_epoch_end(self, epoch, logs=None):\n",
    "        # Predict on validation set\n",
    "        y_pred_probs = self.model.predict(self.val_data, verbose=0)\n",
    "        y_pred = np.argmax(y_pred_probs, axis=1)\n",
    "        y_true = np.argmax(self.val_labels, axis=1)\n",
    "        \n",
    "        # Compute macro F1\n",
    "        macro_f1 = f1_score(y_true, y_pred, average='macro', zero_division=0)\n",
    "        \n",
    "        # Compute High class (class 2) recall\n",
